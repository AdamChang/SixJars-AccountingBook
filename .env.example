# SixJars API 的環境變數範本：只放 placeholder，真實的值放在 .env（已列入 .gitignore）或 Secret Manager（docs/deploy.md）。
# 複製成 .env 後填入，例如：docker run --env-file .env -p 8080:8080 sixjars-api

# 執行環境。Development 以外（含 Production）缺少下方 Google 設定時，app 會在啟動時直接失敗（T36），不會帶著壞掉的登入上線。
ASPNETCORE_ENVIRONMENT=Production

# 資料庫：Neon 的直連 endpoint（host 不含 -pooler），一律 SSL（ADR 0007）。
# app 用只有 DML 權限的角色；執行 migration 的 DDL 角色不要放在這裡（docs/deploy.md）。
ConnectionStrings__SixJars=Host=<neon-host>;Port=5432;Database=<database>;Username=<app-role>;Password=<password>;SSL Mode=Require

# Google 登入（OAuth client 類型為 Web application，redirect URI 為 https://<網域>/auth/callback）。
Authentication__Google__ClientId=<client-id>.apps.googleusercontent.com
Authentication__Google__ClientSecret=<client-secret>

# MediatR 授權金鑰（Community license）；沒有設定時只記一筆 warning，功能正常。
MediatR__LicenseKey=<community-license-key>
